# Public project values. Safe to expose to the browser because database access is protected by RLS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
APP_URL=http://localhost:5173

# Server only. Never prefix this value with VITE_ and never expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Payment and email credentials are consumed only by createServerFn handlers.
PAYSTACK_SECRET_KEY=sk_test_replace_me
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-replace-me
FLUTTERWAVE_WEBHOOK_HASH=replace-with-a-long-random-webhook-secret
RESEND_API_KEY=re_replace_me
TRANSACTIONAL_EMAIL_FROM=NDH Estore <orders@ndh.com.ng>
EMAIL_DISPATCH_SECRET=
# 32+ random characters used only server-side to encrypt integration credentials
INTEGRATION_ENCRYPTION_KEY=
# Override when upgrading Meta's Graph API version
META_GRAPH_API_VERSION=v23.0replace-with-a-long-random-cron-secret
